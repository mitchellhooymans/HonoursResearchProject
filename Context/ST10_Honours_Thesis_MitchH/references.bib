@article{ilic_physical_2010,
	title = {Physical properties of the broad line region in active galactic nuclei},
	volume = {257},
	issn = {1742-6596},
	url = {https://iopscience.iop.org/article/10.1088/1742-6596/257/1/012034},
	doi = {10.1088/1742-6596/257/1/012034},
	abstract = {We present here the study of the plasma in the broad line region (BLR) of active galactic nuclei (AGN). In order to probe the physical properties of the emitting plasma in the BLR we analyze the ﬂuxes of the following broad emission lines (BELs): the hydrogen Balmer lines (Hα to Hε) and the helium lines from two subsequent ionization levels (He II λ4686 and He I λ5876). The BELs are obtained from the spectral synthesis photoionization code CLOUDY. We investigate these BELs in order to ﬁnd conditions in the BLR where so-called Boltzmannplot (BP) can be applied, and we found that in a number of modeled spectra it is working. We used these spectra to explore the dependence between plasma parameters (e.g. the averaged temperature, hydrogen density, etc.) and the ratio of He II λ4686 and He I λ5876 lines.},
	language = {en},
	urldate = {2024-05-17},
	journal = {Journal of Physics: Conference Series},
	author = {Ilic, Dragana and Popovic, Luka C and Ciroi, Stefano and Mura, Giovanni La and Rafanelli, Piero},
	month = nov,
	year = {2010},
	pages = {012034},
}

