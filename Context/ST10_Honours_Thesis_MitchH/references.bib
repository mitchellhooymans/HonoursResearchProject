@article{brown_spectral_2019,
	title = {The spectral energy distributions of active galactic nuclei},
	volume = {489},
	issn = {0035-8711, 1365-2966},
	url = {https://academic.oup.com/mnras/article/489/3/3351/5556950},
	doi = {10.1093/mnras/stz2324},
	abstract = {ABSTRACT
            We present spectral energy distributions (SEDs) of 41 active galactic nuclei, derived from multiwavelength photometry and archival spectroscopy. All of the SEDs span at least 0.09 to 30 \${\textbackslash}mu\$m, but in some instances wavelength coverage extends into the X-ray, far-infrared, and radio. For some active galactic nuclei (AGNs) we have fitted the measured far-infrared photometry with greybody models, while radio flux density measurements have been approximated by power laws or polynomials. We have been able to fill some of the gaps in the spectral coverage using interpolation or extrapolation of simple models. In addition to the 41 individual AGN SEDs, we have produced 72 Seyfert SEDs by mixing SEDs of the central regions of Seyferts with galaxy SEDs. Relative to the literature, our templates have broader wavelength coverage and/or higher spectral resolution. We have tested the utility of our SEDs by using them to generate photometric redshifts for 0 \&lt; z ≤ 6.12 AGNs in the Boötes field (selected with X-ray, IR, and optical criteria) and, relative to SEDs from the literature, they produce comparable or better photometric redshifts with reduced flux density residuals.},
	language = {en},
	number = {3},
	urldate = {2024-02-29},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Brown, M J I and Duncan, K J and Landt, H and Kirk, M and Ricci, C and Kamraj, N and Salvato, M and Ananna, T},
	month = nov,
	year = {2019},
	keywords = {Read},
	pages = {3351--3367},
}

@article{sokol_uv-fir_2023,
	title = {{UV}-{FIR} {SED} modelling of {AGNs} in {IR}-luminous galaxies up to \textit{z} ∼ 2.5: understanding the effects of torus models},
	volume = {521},
	issn = {0035-8711, 1365-2966},
	shorttitle = {{UV}-{FIR} {SED} modelling of {AGNs} in {IR}-luminous galaxies up to \textit{z} ∼ 2.5},
	url = {https://academic.oup.com/mnras/article/521/1/818/7060392},
	doi = {10.1093/mnras/stad589},
	abstract = {ABSTRACT
            UV-FIR spectral energy distribution (SED) modelling is an effective way to disentangle emission between star formation (SF) and active galactic nuclei (AGNs) in galaxies; however, this approach becomes uncertain for composite AGNs/SF galaxies that comprise 50–70 per cent of IR-samples. Cosmic X-ray background (XRB) models require a large fraction of obscured AGNs to reproduce the observed XRB peak, motivating reliable SED analyses in objects where the AGNs may be ‘buried’ in the galaxy and in the mid-IR to far-IR SED. In this paper, we study a 24 \${\textbackslash}mu\$m-selected (S24 \&gt; 100 \${\textbackslash}mu\$Jy) sample of 95 galaxies with \$0{\textasciitilde}\{\{{\textbackslash} {\textbackslash}rm per{\textbackslash} cent\}\} {\textbackslash}lt f\_\{{\textbackslash}mathrm\{ MIR\},{\textbackslash}mathrm\{ AGN\}\} {\textbackslash}lt 100{\textasciitilde}\{\{{\textbackslash} {\textbackslash}rm per{\textbackslash} cent\}\}\$, 0.4 \&lt; z \&lt; 2.7, and 1011L⊙ \&lt; LIR \&lt; 1013L⊙. We test the performance of AGN models ranging in torus optical depth via SED fitting, comparing results with Spitzer mid-infrared spectroscopy and X-ray observations. The best-fitting torus optical depth can shed light on whether these galaxies host a luminous obscured AGN population. We find that permitting a broader AGN SED parameter space results in improved fit quality with higher optical depths, higher FIR AGN contributions, and higher LBol, impacting the bright end of the LBol luminosity function. Our results suggest there may be a population of dust-obscured composites that are bolometrically significant but have their AGNs mostly hidden in the mid-IR SED. If so, literature applications of SED fitting that often simplify AGN models or omit optically thick tori may largely underestimate AGN contribution from composite sources, as these sources are both numerous and have solutions sensitive to the assumed range of AGN models.},
	language = {en},
	number = {1},
	urldate = {2024-03-04},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Sokol, Alyssa D and Yun, M and Pope, A and Kirkpatrick, A and Cooke, K},
	month = mar,
	year = {2023},
	keywords = {Read},
	pages = {818--835},
}

