@article{quilis_gone_2000,
	title = {Gone with the {Wind}: {The} {Origin} of {S0} {Galaxies} in {Clusters}},
	volume = {288},
	issn = {0036-8075, 1095-9203},
	shorttitle = {Gone with the {Wind}},
	url = {https://www.science.org/doi/10.1126/science.288.5471.1617},
	doi = {10.1126/science.288.5471.1617},
