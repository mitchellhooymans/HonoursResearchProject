@article{kim_galaxy_2018,
	title = {{GALAXY} {STRUCTURE}, {STELLAR} {POPULATIONS}, {AND} {STAR} {FORMATION} {QUENCHING} {AT} 0.6 ≲ z ≲ 1.2},
	volume = {867},
	issn = {0004-637X},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6999741/},
	doi = {10.3847/1538-4357/aae488},
	abstract = {We use both photometric and spectroscopic data from the Hubble Space Telescope to explore the relationships among 4000 Å break (D4000) strength, colors, stellar masses, and morphology, in a sample of 352 galaxies with log(M*/M⊙) {\textgreater} 9.44 at 0.6 ≲ z ≲ 1.2. We have identified authentically quiescent galaxies in the UVJ diagram based on their D4000 strengths. This spectroscopic identification is in good agreement with their photometrically-derived specific star formation rates (sSFR). Morphologically, most (that is, 66 out of 68 galaxies, {\textasciitilde} 97 \%) of these newly identified quiescent galaxies have a prominent bulge component. However, not all of the bulge-dominated galaxies are quenched. We found that bulge-dominated galaxies show positive correlations among the D4000 strength, stellar mass, and the Sérsic index, while late-type disks do not show such strong positive correlations. Also, bulge-dominated galaxies are clearly separated into two main groups in the parameter space of sSFR vs. stellar mass and stellar surface density within the effective radius, Σe, while late-type disks and irregulars only show high sSFR. This split is directly linked to the ‘blue cloud’ and the ‘red sequence’ populations, and correlates with the associated central compactness indicated by Σe. While star-forming massive late-type disks and irregulars (with D4000 {\textless} 1.5 and log(M*/M⊙) ≳ 10.5) span a stellar mass range comparable to bulge-dominated galaxies, most have systematically lower Σe ≲ 109M⊙kpc−2. This suggests that the presence of a bulge is a necessary but not sufficient requirement for quenching at intermediate redshifts.},
	number = {2},
	urldate = {2024-10-09},
	journal = {The Astrophysical journal},
	author = {Kim, Keunho and Malhotra, Sangeeta and Rhoads, James E. and Joshi, Bhavin and Fererras, Ignacio and Pasquali, Anna},
	month = nov,
	year = {2018},
	pmid = {32020921},
	pmcid = {PMC6999741},
	pages = {10.3847/1538--4357/aae488},
}

@article{florez_exploring_2020,
	title = {Exploring {AGN} and star formation activity of massive galaxies at cosmic noon},
	volume = {497},
	issn = {0035-8711},
	url = {https://doi.org/10.1093/mnras/staa2200},
	doi = {10.1093/mnras/staa2200},
	abstract = {We investigate the relation between active galactic nucleus (AGN) and star formation (SF) activity at 0.5 \&lt; z \&lt; 3 by analysing 898 galaxies with X-ray luminous AGNs (LX \&gt; 1044 erg s−1) and a large comparison sample of ∼320 000 galaxies without X-ray luminous AGNs. Our samples are selected from a large (11.8 deg2) area in Stripe 82 that has multiwavelength (X-ray to far-IR) data. The enormous comoving volume (∼0.3 Gpc3) at 0.5 \&lt; z \&lt; 3 minimizes the effects of cosmic variance and captures a large number of massive galaxies (∼30 000 galaxies with M* \&gt; 1011 M⊙) and X-ray luminous AGNs. While many galaxy studies discard AGN hosts, we fit the SED of galaxies with and without X-ray luminous AGNs with Code Investigating GALaxy Emission and include AGN emission templates. We find that without this inclusion, stellar masses and star formation rates (SFRs) in AGN host galaxies can be overestimated, on average, by factors of up to ∼5 and ∼10, respectively. The average SFR of galaxies with X-ray luminous AGNs is higher by a factor of ∼3–10 compared to galaxies without X-ray luminous AGNs at fixed stellar mass and redshift, suggesting that high SFRs and high AGN X-ray luminosities may be fuelled by common mechanisms. The vast majority (\${\textbackslash}gt 95 \{\{{\textbackslash} {\textbackslash}rm per{\textbackslash} cent\}\}\$) of galaxies with X-ray luminous AGNs at z = 0.5−3 do not show quenched SF: this suggests that if AGN feedback quenches SF, the associated quenching process takes a significant time to act and the quenched phase sets in after the highly luminous phases of AGN activity.},
	number = {3},
	urldate = {2024-10-09},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Florez, Jonathan and Jogee, Shardha and Sherman, Sydney and Stevans, Matthew L and Finkelstein, Steven L and Papovich, Casey and Kawinwanichakij, Lalitwadee and Ciardullo, Robin and Gronwall, Caryl and Urry, C Megan and Kirkpatrick, Allison and LaMassa, Stephanie M and Ananna, Tonima Tasnim and Wold, Isak},
	month = sep,
	year = {2020},
	pages = {3273--3296},
}

@article{nour_association_2023,
	title = {Association of optical, ultraviolet, and soft {X}-ray excess emissions in {AGNs}},
	volume = {518},
	issn = {0035-8711},
	url = {https://doi.org/10.1093/mnras/stac3505},
	doi = {10.1093/mnras/stac3505},
	abstract = {Soft X-ray emission (0.5–2.0 keV) plays a pivotal role in regulating the optical and ultraviolet (UV) emission in the active galactic nuclei (AGNs). We collected a sample of 1811 AGNs from the SDSS database and obtained various parameters of Balmer lines, optical continuum, Mg ii line \&amp; UV continuum and studied their dependencies on soft X-ray luminosity. Based on the linear regression analysis, we found that FWHM\$\_\{{\textbackslash}rm \{Mg{\textbackslash},{\textbackslash},{\textbackslash}small \{II\}\}\}\$ ∝ FWHM\$\_\{{\textbackslash}text\{H\}{\textbackslash}beta \}{\textasciicircum}\{0.554\}\$ suggesting that UV emission is arising from a region relatively outside the broad-line region (BLR) associated to the Hβ emission and found a strong correlation between optical and UV luminosities (L\$\_\{{\textbackslash}rm \{Mg{\textbackslash},{\textbackslash},{\textbackslash}small \{II\}\}\}\$ ∝ \$L\_\{{\textbackslash}rm \{H\}{\textbackslash}beta \}{\textasciicircum}\{0.822\}\$). It was noticed that the dependency of optical continuum luminosities on soft excess changes with the redshift (LX ∝ L\${\textasciicircum}\{0.596\}\_\{5100{\textbackslash}, {\textbackslash}mathring\{{\textbackslash}rm A\}\}\$ for z \&lt; 0.5 and LX ∝ L\${\textasciicircum}\{0.429\}\_\{5100{\textbackslash}, {\textbackslash}mathring\{{\textbackslash}rm A\}\}\$ for z \&gt; 0.5). The full width at half-maximum components of Hβ and Mg ii core components were found to be virialized and is not affected by the soft excess emission whereas the wings of Mg ii display a dependency. We estimated a relation viz. LX ∝L\${\textasciicircum}\{0.520\}\_\{3000{\textbackslash}, {\textbackslash}mathring\{{\textbackslash}rm A\}\}\$ FWHM\${\textasciicircum}\{0.525\}\_\{{\textbackslash}rm \{Mg{\textbackslash},{\textbackslash},{\textbackslash}small \{II\}\}\}\$ and found to be well in agreement with a proposed physical scenario. All the derived relations were used to understand the intermodulating association of the BLR and disc in the AGNs.},
	number = {4},
	urldate = {2024-10-09},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Nour, D and Sriram, K},
	month = feb,
	year = {2023},
	pages = {5705--5717},
}

