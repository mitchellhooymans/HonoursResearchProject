	title = {Stellar populations of galaxies in the {ALHAMBRA} survey up to z ∼ 1: {II}. {Stellar} content of quiescent galaxies within the dust-corrected stellar mass–colour and the \textit{{U}} \textit{{V}} \textit{{J}} colour–colour diagrams},
