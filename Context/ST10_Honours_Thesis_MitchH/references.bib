	volume = {33},
	issn = {0066-4146},
	url = {https://ui.adsabs.harvard.edu/abs/1995ARA&A..33..581K},
	doi = {10.1146/annurev.aa.33.090195.003053},
	abstract = {Dynamical searches reveal central dark objects with masses \${\textbackslash}sim 10{\textasciicircum}6\$to \$10{\textasciicircum}\{9.5\}\$ {\textbackslash}msun in the Galaxy, {\textbackslash}m31, {\textbackslash}mm32, M87, NGC 3115, NGC 3377, NGC 4258, and NGC 4594. Indirect arguments suggest but do not prove that these are supermassive black holes (BHs) like those postulated as quasar engines. This paper reviews dynamical search techniques, the robustness of the evidence, and BH demographics. Stellar-dynamical evidence is generally more robust than gas-dynamical evidence (gas velocities can be nongravitational), but gas measurements reach closer to the Schwarzschild radius, and in NGC 4258 they show a Keplerian rotation curve. A statistical survey finds BHs in \${\textbackslash}sim 20{\textbackslash}\%\$ of nearby E--Sbc galaxies, consistent with predictions based on quasar energetics. BH masses are proportional to the mass of the bulge component. Most candidates are inactive; in some cases, the abundance of fuel is not easily reconciled with BH starvation. Flashes caused by the accretion of individual stars may provide a test of the BH picture.},
	urldate = {2024-04-21},
	journal = {Annual Review of Astronomy and Astrophysics},
	author = {Kormendy, John and Richstone, Douglas},
	month = jan,
	year = {1995},
	note = {ADS Bibcode: 1995ARA\&A..33..581K},
	pages = {581},
}

