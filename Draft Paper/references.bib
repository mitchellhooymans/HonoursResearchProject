@article{faaique_overview_2023,
	title = {Overview of {Big} {Data} {Analytics} in {Modern} {Astronomy}},
	volume = {2},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {2704-1069, 2704-1077},
	url = {https://ijmscs.org/index.php/ijmscs/article/view/8561},
	doi = {10.59543/ijmscs.v2i.8561},
	abstract = {Astronomers are increasingly compelled to chart the universe with ever greater precision. Projects like the Sloan Digital Sky Survey (SDSS), Pan-STARRS, and the Large Synoptic Survey Telescope (LSST) generate approximately 100-200 Petabytes of data annually, presenting significant big data challenges in terms of storage, processing, and data transfer. The Square Kilometer Array (SKA), an ambitious project involving 130,000 antennas and 200 dishes spanning two continents, is scheduled to become operational in 2028. It will collect 160 terabytes of data per second, translating to 1 petabyte of data daily. Coping with this immense volume of data necessitates real-time processing and analysis, driving the need for efficient machine learning and image analysis algorithms. Astronomy stands as an ideal domain for big data analytics, pushing the boundaries of data analysis. This review paper will present intriguing applications for data scientists, exploring the challenges and recent technological advancements in big data analytics concerning astronomy. The paper will also critically assess the strengths and weaknesses of various approaches, methodologies, or tools used in big data analytics within the context of astronomy, supported by relevant case studies.},
	urldate = {2024-10-18},
	journal = {International Journal of Mathematics, Statistics, and Computer Science},
	author = {Faaique, Muhammad},
	month = dec,
	year = {2023},
	pages = {96--113},
}

@article{pierce_effects_2010,
	title = {The effects of an active galactic nucleus on host galaxy colour and morphology measurements},
	volume = {405},
	issn = {0035-8711},
	url = {https://doi.org/10.1111/j.1365-2966.2010.16502.x},
	doi = {10.1111/j.1365-2966.2010.16502.x},
	abstract = {We assess the effects of simulated active galactic nuclei (AGN) on the colour and morphology measurements of their host galaxies. To test the morphology measurements, we select a sample of galaxies not known to host AGN and add a series of point sources scaled to represent specified fractions of the observed V-band light detected from the resulting systems; we then compare morphology measurements of the simulated systems to measurements of the original galaxies. AGN contributions \&gt;rsim 20 per cent bias most of the morphology measurements tested, though the extent of the apparent bias depends on the morphological characteristics of the original galaxies. We test colour measurements by adding to non-AGN galaxy spectra a quasar spectrum scaled to contribute specified fractions of the rest-frame B-band light detected from the resulting systems. A quasar fraction of 5 per cent can move the NUV −r colour of an elliptical galaxy from the ultraviolet–optical red sequence to the green valley, and 20 per cent can move it into the blue cloud. Combining the colour and morphology results, we find that a galaxy/AGN system with an AGN contribution \&gt;rsim 20 per cent may appear bluer and more bulge dominated than the underlying galaxy. We conclude that (1) bulge-dominated, E/S0/Sa, and early-type morphology classifications are accurate for red AGN host galaxies and may be accurate for blue host galaxies, unless the AGN manifests itself as a well-defined point source and (2) although highly unobscured AGN, such as the quasar used for our experiments, can significantly bias the measured colours of AGN host galaxies, it is possible to identify such systems by examining optical images of the hosts for the presence of a point source and/or measuring the level of nuclear obscuration.},
	number = {2},
	urldate = {2024-10-16},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Pierce, C. M. and Lotz, J. M. and Primack, J. R. and Rosario, D. J. V. and Griffith, R. L. and Conselice, C. J. and Faber, S. M. and Koo, D. C. and Coil, A. L. and Salim, S. and Koekemoer, A. M. and Laird, E. S. and Ivison, R. J. and Yan, R.},
	month = jun,
	year = {2010},
	pages = {718--734},
}

@article{fiore_faint_2012,
	title = {Faint high-redshift {AGN} in the {Chandra} deep field south: the evolution of the {AGN} luminosity function and black hole demography},
	volume = {537},
	copyright = {© ESO, 2012},
	issn = {0004-6361, 1432-0746},
	shorttitle = {Faint high-redshift {AGN} in the {Chandra} deep field south},
	url = {https://www.aanda.org/articles/aa/abs/2012/01/aa17581-11/aa17581-11.html},
	doi = {10.1051/0004-6361/201117581},
	abstract = {{\textless}i{\textgreater}Context.{\textless}i/{\textgreater} We present detection and analysis of faint X-ray sources in the {\textless}i{\textgreater}Chandra {\textless}i/{\textgreater}deep field south (CDFS) using the 4 Ms {\textless}i{\textgreater}Chandra {\textless}i/{\textgreater}observation.{\textless}i{\textgreater}Aims.{\textless}i/{\textgreater} We place constraints on active galactic nuclei (AGN) luminosity functions at {\textless}i{\textgreater}z{\textless}i/{\textgreater} = 3–7, its cosmological evolution, and high-redshift black hole and AGN demography.{\textless}i{\textgreater}Methods.{\textless}i/{\textgreater} We use a new detection algorithm, using the entire three-dimensional data-cube (position and energy), and searching for X-ray counts at the position of high-{\textless}i{\textgreater}z{\textless}i/{\textgreater} galaxies in the GOODS-South survey.{\textless}i{\textgreater}Results.{\textless}i/{\textgreater} This optimized technique results in the identification of 54 AGN at {\textless}i{\textgreater}z{\textless}i/{\textgreater} {\textgreater} 3, 29 of which are new detections. Applying stringent completeness criteria, we derive AGN luminosity functions in the redshift bins 3–4, 4–5, and {\textgreater} 5.8 and for 42.75 {\textless} log {\textless}i{\textgreater}L{\textless}i/{\textgreater}(2–10 keV) {\textless} 44.5. We combine this data with the luminous AGN luminosity functions from optical surveys and find that the evolution of the high-{\textless}i{\textgreater}z{\textless}i/{\textgreater}, wide luminosity range luminosity function can be modeled by pure luminosity evolution with {\textless}i{\textgreater}L{\textless}i/{\textgreater}{\textless}sup{\textgreater}∗{\textless}sup/{\textgreater} decreasing from 6.6 × 10{\textless}sup{\textgreater}44{\textless}sup/{\textgreater} erg/s at {\textless}i{\textgreater}z{\textless}i/{\textgreater} = 3 to {\textless}i{\textgreater}L{\textless}i/{\textgreater}{\textless}sup{\textgreater}∗{\textless}sup/{\textgreater} = 2 × 10{\textless}sup{\textgreater}44{\textless}sup/{\textgreater} erg/s at {\textless}i{\textgreater}z{\textless}i/{\textgreater} = 6. We compare the high-{\textless}i{\textgreater}z{\textless}i/{\textgreater} luminosity function with the predictions of theoretical models using galaxy interactions as AGN triggering mechanism. We find that these models are broadly able to reproduce the high-{\textless}i{\textgreater}z{\textless}i/{\textgreater} AGN luminosity functions. Closer agreement is found when we assume a minimum dark matter halo mass for black hole formation and growth. We compare our AGN luminosity functions with galaxy mass functions to derive the high-{\textless}i{\textgreater}z{\textless}i/{\textgreater} AGN duty cycle, using observed Eddington ratio distributions to derive black hole masses. We find that the duty cycle increases with galaxy stellar mass and redshift by a factor of 10–30 from {\textless}i{\textgreater}z{\textless}i/{\textgreater} = 0.25 to {\textless}i{\textgreater}z{\textless}i/{\textgreater} = 4–5. We also report the detection of a large fraction of highly obscured, Compton thick AGN at {\textless}i{\textgreater}z{\textless}i/{\textgreater} {\textgreater} 3 (18{\textless}sub{\textgreater}-10{\textless}sub/{\textgreater}{\textless}sup{\textgreater}+17{\textless}sup/{\textgreater} \%). Their optical counterparts do not show any reddening and we thus conclude that the size of the X-ray absorber is likely smaller than the dust sublimation radius. We finally report the discovery of a highly star-forming galaxy at {\textless}i{\textgreater}z{\textless}i/{\textgreater} = 3.47, arguing that its X-ray luminosity is likely dominated by stellar sources. If confirmed, this would be one of the farthest objects in which stellar sources have been detected in X-rays.},
	language = {en},
	urldate = {2024-10-16},
	journal = {Astronomy \& Astrophysics},
	publisher = {EDP Sciences},
	author = {Fiore, F. and Puccetti, S. and Grazian, A. and Menci, N. and Shankar, F. and Santini, P. and Piconcelli, E. and Koekemoer, A. M. and Fontana, A. and Boutsia, K. and Castellano, M. and Lamastra, A. and Malacaria, C. and Feruglio, C. and Mathur, S. and Miller, N. and Pannella, M.},
	month = jan,
	year = {2012},
	pages = {A16},
}

