	abstract = {Abstract
            
              Ultra-light dark matter is a class of dark matter models (DM), where DM is composed by bosons with masses ranging from
              
                
                  \$\$10{\textasciicircum}\{-24\}{\textbackslash}, {\textbackslash}mathrm \{eV\}{\textless} m {\textless} {\textbackslash}mathrm \{eV\}\$\$
                  
                    
                      
                        10
                        
