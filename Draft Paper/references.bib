@article{pavlik_black_2018,
	title = {The black hole retention fraction in star clusters},
	volume = {617},
	copyright = {© ESO 2018},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2018/09/aa32919-18/aa32919-18.html},
	doi = {10.1051/0004-6361/201832919},
	abstract = {{\textless}i{\textgreater}Context.{\textless}i/{\textgreater} Recent research has been constraining the retention fraction of black holes (BHs) in globular clusters by comparing the degree of mass segregation with {\textless}i{\textgreater}N{\textless}i/{\textgreater}-body simulations. They are consistent with an upper limit of the retention fraction being 50\% or less.{\textless}i{\textgreater}Aims{\textless}i/{\textgreater}. In this work, we focus on direct simulations of the dynamics of BHs in star clusters. We aim to constrain the effective distribution of natal kicks that BHs receive during supernova (SN) explosions and to estimate the BH retention fraction.{\textless}i{\textgreater}Methods{\textless}i/{\textgreater}. We used the collisional {\textless}i{\textgreater}N{\textless}i/{\textgreater}-body code nbody6 to measure the retention fraction of BHs for a given set of parameters, which are: the initial mass of a star cluster, the initial half-mass radius, and {\textless}i{\textgreater}σ{\textless}i/{\textgreater}{\textless}sub{\textgreater}BH{\textless}sub/{\textgreater}, which sets the effective Maxwellian BH velocity kick distribution. We compare these direct {\textless}i{\textgreater}N{\textless}i/{\textgreater}-body models with our analytic estimates and newest observational constraints.{\textless}i{\textgreater}Results.{\textless}i/{\textgreater} The numerical simulations show that for the one-dimensional velocity kick dispersion {\textless}i{\textgreater}σ{\textless}i/{\textgreater}{\textless}sub{\textgreater}BH{\textless}sub/{\textgreater} {\textless} 50 km s{\textless}sup{\textgreater}−1{\textless}sup/{\textgreater}, clusters with radii of 2 pc and that are initially more massive than 5 × 10{\textless}sup{\textgreater}3{\textless}sup/{\textgreater} {\textless}i{\textgreater}M{\textless}i/{\textgreater}{\textless}sub{\textgreater}⊙{\textless}sub/{\textgreater} retain more than 20\% of BHs within their half-mass radii. Our simple analytic model yields a number of retained BHs that is in good agreement with the {\textless}i{\textgreater}N{\textless}i/{\textgreater}-body models. Furthermore, the analytic estimates show that ultra-compact dwarf galaxies should have retained more than 80\% of their BHs for {\textless}i{\textgreater}σ{\textless}i/{\textgreater}{\textless}sub{\textgreater}BH{\textless}sub/{\textgreater} ≤ 190 km s{\textless}sup{\textgreater}−1{\textless}sup/{\textgreater}. Although our models do not contain primordial binaries, in the most compact clusters with 10{\textless}sup{\textgreater}3{\textless}sup/{\textgreater} stars, we have found evidence of delayed SN explosions producing a surplus of BHs compared to the IMF due to dynamically formed binary stars. These cases do not occur in the more populous or expanded clusters.},
	language = {en},
	urldate = {2025-05-02},
	journal = {Astronomy \& Astrophysics},
	publisher = {EDP Sciences},
	author = {Pavlík, Václav and Jeřábková, Tereza and Kroupa, Pavel and Baumgardt, Holger},
	month = sep,
	year = {2018},
	pages = {A69},
}

@article{wang_impact_2022,
	title = {The impact of primordial binary on the dynamical evolution of intermediate massive star clusters},
	volume = {509},
	issn = {0035-8711},
	url = {https://doi.org/10.1093/mnras/stab3255},
	doi = {10.1093/mnras/stab3255},
	abstract = {Observations found that star clusters contain a large fraction of binaries. Tight binaries are an important heating source that influences the long-term dynamical evolution of star clusters. However, due to the limitation of N-body tool, previous theoretical modelling for globular clusters (GCs) by using direct N-body simulations has not investigated how a large fraction of primordial binaries affect their long-term evolution. In this work, by using the high-performance N-body code, petar, we carry out star-by-star models for intermediate massive GCs (N = 100 000) with the primordial binary fraction varying from 0 to 1. We find that when a stellar-mass black hole (BH) subsystem exists, the structural evolution of GCs (core and half-mass radii) only depends on the properties of massive primordial binaries, because they affect the number of BH binaries (BBHs), which dominate the binary heating process. Low-mass binaries including double white dwarf binaries (BWDs) have almost no influence on the dynamics. Meanwhile, only gravitational wave mergers from BBHs are strongly affected by dynamical interactions, while low-mass mergers from BWDs show no difference in the isolated environment (field) and in GCs. Low-mass binaries become important only after most BHs escape and the core collapse of light stars occurs. Our result suggests that for N-body modelling of GCs with a BH subsystem dominating binary heating, it is not necessary to include low-mass binaries. These binaries can be studied separately by using standalone binary stellar evolution codes. This way can significantly reduce the computing cost.},
	number = {4},
	urldate = {2025-05-02},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Wang, Long and Tanikawa, Ataru and Fujii, Michiko S},
	month = feb,
	year = {2022},
	pages = {4713--4722},
}

@misc{kim_fitting_1999,
	title = {Fitting formulae for cross sections of tidal capture binary formation},
	url = {https://ui.adsabs.harvard.edu/abs/1999A&A...347..123K},
	doi = {10.48550/arXiv.astro-ph/9905115},
	abstract = {Tidal captures can produce objects that are observationally and dynamically important in dense stellar systems. Recent discoveries of compact young clusters in and out of the Galaxy have prompted the studies of dynamics of star clusters with a large range in stellar masses. The tidal interactions between high and low mass stars are found to be rather frequent in such clusters. In this Research Note, we present fitting formulae for the cross sections of tidal capture binary formation between two stars with a large mass ratio. We present the cases between two main-sequence stars, and between a degenerate star and a main-sequence star.},
