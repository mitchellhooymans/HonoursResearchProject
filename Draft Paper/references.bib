@article{daoutis_versatile_2023,
	title = {A versatile classification tool for galactic activity using optical and infrared colors},
	volume = {679},
	copyright = {© The Authors 2023},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2023/11/aa47016-23/aa47016-23.html},
	doi = {10.1051/0004-6361/202347016},
	abstract = {{\textless}i{\textgreater}Context.{\textless}i/{\textgreater} The overwhelming majority of diagnostic tools for galactic activity are focused mainly on the classes of active galaxies. Passive or dormant galaxies are often excluded from these diagnostics, which usually employ emission-line features (e.g., forbidden emission lines). Thus, most of them focus on specific types of activity or only on one activity class, for example active galactic nucleus (AGN) galaxies{\textless}i{\textgreater}Aims.{\textless}i/{\textgreater} In this work we used infrared and optical colors to build an all-inclusive galactic activity diagnostic tool that can discriminate between star-forming, AGN, low-ionization nuclear emission-line region, composite, and passive galaxies, and which can be used in local and low-redshift galaxies.{\textless}i{\textgreater}Methods.{\textless}i/{\textgreater} We used the random forest algorithm to define a new activity diagnostic tool. As the ground truth for the training of the algorithm, we considered galaxies that have been classified based on their optical spectral lines. We explored classification criteria based on infrared colors from the first three WISE bands (bands 1, 2, and 3) supplemented with optical colors from the {\textless}i{\textgreater}u, g{\textless}i/{\textgreater}, and {\textless}i{\textgreater}r{\textless}i/{\textgreater} SDSS bands. From them, we sought the combination with the minimum number of colors that provides optimal results. Furthermore, to mitigate biases related to aperture effects, we introduced a new WISE photometric scheme that combines apertures of different sizes.{\textless}i{\textgreater}Results.{\textless}i/{\textgreater} Using machine learning methods, we developed a diagnostic tool that accommodates both active and passive galaxies under one unified classification scheme using just three colors. We find that the combination of {\textless}i{\textgreater}W1-W2, W2-W3{\textless}i/{\textgreater}, and g-r colors offers a good performance, while the broad availability of these colors for a large number of galaxies ensures it can be applied to large galaxy samples. The overall accuracy is {\textasciitilde}81\%, and the achieved completeness for each class is {\textasciitilde}81\% for star-forming, {\textasciitilde}56\% for AGN, {\textasciitilde}68\% for LINER, {\textasciitilde}65\% for composite, and {\textasciitilde}85\% for passive galaxies.{\textless}i{\textgreater}Conclusions.{\textless}i/{\textgreater} Our diagnostic represents a significant improvement over existing infrared diagnostics because it includes all types of active galaxies, as well as passive galaxies, extending their application to the local Universe. The inclusion of the optical colors improves its ability to identify low-luminosity AGN galaxies, which are generally confused with star-forming galaxies, and helps us identify cases of starbursts with extreme mid-infrared colors that mimic obscured AGN galaxies, a well-known problem for most infrared diagnostics.},
	language = {en},
	urldate = {2024-10-23},
	journal = {Astronomy \& Astrophysics},
	publisher = {EDP Sciences},
	author = {Daoutis, C. and Kyritsis, E. and Kouroumpatzakis, K. and Zezas, A.},
	month = nov,
	year = {2023},
	pages = {A76},
}

