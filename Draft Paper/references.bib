@article{tomczak_sfrm_2016,
	title = {{THE} {SFR}–{M} $_{\textrm{*}}$ {RELATION} {AND} {EMPIRICAL} {STAR} {FORMATION} {HISTORIES} {FROM} {ZFOURGE} {AT} 0.5 {\textless} z {\textless} 4*},
	volume = {817},
